{
  "name": "harborlane",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Harborlane is a portfolio demo: a multi-tenant workspace for clients, tasks, and invoices.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "SCREENSHOTS=1 playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "prisma": "6.19.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
