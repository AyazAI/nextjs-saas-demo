# Copy to .env. Never commit .env. These values are local placeholders.

# Postgres. docker compose already sets this for the app service.
DATABASE_URL="postgresql://harborlane:harborlane@localhost:5432/harborlane?schema=public"

# Auth.js / NextAuth. Generate a real value with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# mock: no Stripe calls. The owner can flip the workspace plan in the app.
# stripe: checkout and webhooks. All three Stripe variables below are required.
# Unset: stripe if the three Stripe variables are set, otherwise mock.
BILLING_MODE="mock"

# Stripe TEST MODE only. Use sk_test_... and a test-mode price. Never put sk_live here.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""

# Optional. When both are set, the login page shows "Continue with GitHub".
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

NEXT_TELEMETRY_DISABLED="1"
